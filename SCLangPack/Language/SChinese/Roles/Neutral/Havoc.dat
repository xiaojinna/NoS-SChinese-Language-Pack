# Assignable
 
"role.havoc.name" : "猎狼"
"role.havoc.short" : "猎"
"role.havoc.blurb" : "终末盛宴"
 
# Document
 
"role.havoc.doc" : "猎狼可以吞噬尸体以强化自身能力。"
"role.havoc.winCond" : "杀死其他所有玩家。"
"role.havoc.ability.title" : "固有能力【混乱无序】"
"role.havoc.ability.main" : "可以啃食尸体以强化自身能力。<br>合理使用嚎鸣争取吞噬更多尸体或击杀更多玩家。"
"role.havoc.ability.devour" : "<title>啃食</title>啃食尸体。每啃食1具尸体，击杀冷却缩短<var>%REDUC%</var>秒。<br>啃食<var>%VENT%</var>具后获得使用通风口能力。<br>啃食<var>%PING%</var>具后，使用嚎鸣可以感知附近玩家的位置。"
"role.havoc.ability.devouredCorpse" : "<title>被啃食的尸体</title>被啃食后的尸体外观会发生变化。<br>该尸体仍然可以报告，但不能拖动。"
"role.havoc.ability.havoc" : "<title>嚎鸣</title>发动后，在<var>%DURATION%</var>秒期间，不能报告尸体与发起紧急会议。<br>嚎鸣会响彻整个地图，但没有具体指向。"
 
# Options
 
"options.role.havoc.detail" : "猎狼可以吞噬尸体以强化自身能力。<br>注：要在还未成长之前驱逐！"
"options.role.havoc.killCooldown" : "初始击杀冷却时间"
"options.role.havoc.killCooldownReduction" : "啃食后击杀缩短秒数"
"options.role.havoc.devourCooldown" : "啃食冷却时间"
"options.role.havoc.maxDevourLevel" : "最大啃食次数"
"options.role.havoc.maxDevourLevel.detail" : "配置可以啃食尸体的最大次数。<br>达到上限后，能力将强化到最大。"
"options.role.havoc.havocCooldown" : "嚎鸣冷却时间"
"options.role.havoc.havocDuration" : "嚎鸣持续时间"
"options.role.havoc.requiredDevourForVent" : "解锁通风口使用能力所需啃食数"
"options.role.havoc.requiredDevourForSearch" : "解锁感知能力所需啃食数"
"options.role.havoc.clearHavocSEDistance" : "可清晰听到嚎鸣音效范围"
"options.role.havoc.clearHavocSEDistance.detail" : "在指定范围内的玩家可以清晰听到嚎鸣的声音。<br>范围外音效会变得模糊。"
 
